NODE_ENV=development
PORT=3020
DATABASE_PATH=/var/lib/livomlivo/releases.sqlite
MIGRATE_ON_START=false
ALLOWED_ORIGINS=

# Generate independent random values of at least 32 characters.
IDEMPOTENCY_SECRET=replace-with-a-random-idempotency-secret
DEPLOYMENT_WEBHOOK_URL=https://deployment-provider.example/v1/releases
DEPLOYMENT_WEBHOOK_SECRET=replace-with-a-random-provider-signing-secret
DEPLOYMENT_TIMEOUT_MS=3000
DEPLOYMENT_MAX_ATTEMPTS=3

# One-time token bootstrap values. Remove TOKEN_ROLE after use.
TOKEN_ORGANIZATION_SLUG=example-tenant
TOKEN_ORGANIZATION_NAME=Example Tenant
TOKEN_LABEL=initial-admin
TOKEN_ROLE=OPERATOR
TOKEN_TTL_DAYS=30
TOKEN_OUTPUT_PATH=/run/secrets/new-livo-token
